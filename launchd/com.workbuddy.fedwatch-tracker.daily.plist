<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.workbuddy.fedwatch-tracker.daily</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>REPLACE_WITH_ABSOLUTE_REPO_PATH/run_daily.sh</string>
  </array>
  <key>WorkingDirectory</key>
  <string>REPLACE_WITH_ABSOLUTE_REPO_PATH</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <!-- 两个触发器，覆盖美东夏令时与冬令时：
       夏令时(CDT) 北京 05:30 = 前一日 16:30 CT
       冬令时(CST) 北京 06:30 = 前一日 16:30 CT
       两者都落在「收盘后休市间隙 [16:02,16:58) CT」内。
       不在窗口内的那一次由 fetch_quikstrike.py 以 exit 10 自行跳过。 -->
  <key>StartCalendarInterval</key>
  <array>
    <dict>
      <key>Hour</key>
      <integer>5</integer>
      <key>Minute</key>
      <integer>30</integer>
    </dict>
    <dict>
      <key>Hour</key>
      <integer>6</integer>
      <key>Minute</key>
      <integer>30</integer>
    </dict>
  </array>
  <key>ProcessType</key>
  <string>Background</string>
  <key>ThrottleInterval</key>
  <integer>60</integer>
  <key>StandardOutPath</key>
  <string>REPLACE_WITH_ABSOLUTE_REPO_PATH/logs/launchd.stdout.log</string>
  <key>StandardErrorPath</key>
  <string>REPLACE_WITH_ABSOLUTE_REPO_PATH/logs/launchd.stderr.log</string>
</dict>
</plist>
