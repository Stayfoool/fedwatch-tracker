#!/usr/bin/env bash
# fedwatch-deploy — 服务器端部署器（安装到 /usr/local/sbin/，root 运行）。
# 从 GitHub 拉取指定 commit，校验后重建静态站点并发布到 nginx 站点目录。
# 由 Mac 端 deploy_server.sh 通过 SSH 触发；构建与发布以 fedwatch 用户执行。
set -Eeuo pipefail

APP=${APP:-/opt/fedwatch-tracker}
RUN_AS=${RUN_AS:-fedwatch}
SITE_URL=${FEDWATCH_SITE_URL:-https://fedwatch-tracker.pages.dev}
LOG_DIR=/var/log/fedwatch
REF=${1:-main}
REQUESTED_COMMIT=${2:-}

fail() { echo "fedwatch-deploy: $*" >&2; exit 1; }
[[ "$(id -u)" == 0 ]] || fail "必须以 root 运行"
[[ -d "$APP/.git" ]] || fail "缺少服务器仓库：$APP（先跑 scripts/server/bootstrap.sh）"
[[ -f "$APP/build_report.py" ]] || fail "仓库内容异常：$APP/build_report.py 缺失"

exec 9>"$APP/.deploy.lock"
flock -n 9 || fail "另一个部署正在进行"

mkdir -p "$LOG_DIR"
exec > >(tee -a "$LOG_DIR/deploy.log") 2>&1
trap 'echo "fedwatch-deploy: 命令在第 $LINENO 行失败: $BASH_COMMAND" >&2' ERR

cd "$APP"
runuser -u "$RUN_AS" -- git fetch --quiet origin
if [[ -n "$REQUESTED_COMMIT" ]]; then
  runuser -u "$RUN_AS" -- git cat-file -e "$REQUESTED_COMMIT^{commit}" 2>/dev/null \
    || runuser -u "$RUN_AS" -- git fetch --quiet origin main
  COMMIT=$(runuser -u "$RUN_AS" -- git rev-parse "$REQUESTED_COMMIT^{commit}")
else
  COMMIT=$(runuser -u "$RUN_AS" -- git rev-parse "origin/${REF#origin/}^{commit}")
fi
[[ "$COMMIT" =~ ^[0-9a-f]{40}$ ]] || fail "无法解析 commit（ref=$REF）"
runuser -u "$RUN_AS" -- git merge-base --is-ancestor "$COMMIT" origin/main \
  || fail "commit 不在 origin/main 历史中：$COMMIT"

# 防呆（2026-10-02 事故）：reset --hard 到 origin/main 会丢弃服务器本地
# 领先 origin 的提交——那通常是采集成功但 sync_data_git.sh 还没推出去的数据。
# 本地一旦领先，先拒绝部署，让数据同步先行，宁可部署晚一天也不丢数据。
AHEAD=$(runuser -u "$RUN_AS" -- git rev-list --count origin/main..main 2>/dev/null || echo 0)
if [[ "$AHEAD" -ne 0 ]]; then
  fail "服务器本地 main 领先 origin/main $AHEAD 个提交（应为采集数据）。" \
       "先修复数据回推（journalctl -u fedwatch-daily | grep sync_data_git），"
fi

CURRENT=$(runuser -u "$RUN_AS" -- git rev-parse HEAD 2>/dev/null || echo none)
if [[ "$COMMIT" == "$CURRENT" && -f "$APP/report/index.html" ]]; then
  echo "fedwatch-deploy: 已是目标 commit $COMMIT，跳过重建（仍同步 pages.dev）"
  SKIP_BUILD=1
fi

sync_pages() {
  # 代码变更后同步刷新 Cloudflare Pages 对外门面（token 已配置才尝试，失败不阻断——
  # 每日 run_daily.sh 仍会重试发布）。
  [[ -f "$APP/publish_pages.sh" ]] || return 0
  if runuser -u "$RUN_AS" -- test -f "/home/$RUN_AS/.config/cloudflare/fedwatch-pages.token"; then
    if runuser -u "$RUN_AS" -- "$APP/publish_pages.sh"; then
      echo "fedwatch-deploy: pages.dev 已同步"
    else
      echo "fedwatch-deploy: pages.dev 同步失败（不阻断，等每日发布重试）" >&2
    fi
  else
    echo "fedwatch-deploy: 未配置 pages token，跳过 pages.dev 同步" >&2
  fi
}

if [[ ${SKIP_BUILD:-0} = 1 ]]; then
  sync_pages
  echo "fedwatch-deploy: 完成（跳过重建）commit=$COMMIT site=$SITE_URL"
  exit 0
fi

runuser -u "$RUN_AS" -- git reset --quiet --hard "$COMMIT"
echo "fedwatch-deploy: checkout $COMMIT"

# package-lock 未变化时跳过 npm ci（agent-browser/wrangler 二进制较大）
LOCK_SHA=$(sha256sum "$APP/package-lock.json" | cut -d' ' -f1)
if [[ ! -d "$APP/node_modules" || "$LOCK_SHA" != "$(cat "$APP/.node-modules.sha" 2>/dev/null || echo none)" ]]; then
  echo "fedwatch-deploy: npm ci"
  runuser -u "$RUN_AS" -- bash -c "cd '$APP' && npm ci --no-fund --no-audit --silent"
  echo "$LOCK_SHA" > "$APP/.node-modules.sha"
  runuser -u "$RUN_AS" -- bash -c "cd '$APP' && ./node_modules/.bin/agent-browser install --with-deps 2>/dev/null || ./node_modules/.bin/agent-browser install"
fi

export FEDWATCH_SITE_URL="$SITE_URL"
runuser -u "$RUN_AS" -- bash -c "cd '$APP' && python3 -m py_compile *.py"
runuser -u "$RUN_AS" -- bash -c "cd '$APP' && python3 snapshot_pick.py"
runuser -u "$RUN_AS" -- bash -c "cd '$APP' && python3 build_report.py"
runuser -u "$RUN_AS" -- bash -c "cd '$APP' && python3 build_curves.py" \
  || echo "fedwatch-deploy: curves.html 生成失败（不阻断）"

# 唯一发布渠道：Cloudflare Pages（nginx 镜像发布已于 2026-10-02 移除）
sync_pages

echo "fedwatch-deploy: 完成 commit=$COMMIT site=$SITE_URL"
