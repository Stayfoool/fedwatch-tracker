[Unit]
Description=FedWatch daily QuikStrike fetch, report build and publish
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=fedwatch
Group=fedwatch
WorkingDirectory=/opt/fedwatch-tracker
Environment=PYTHON_BIN=/usr/bin/python3
# 规范地址 = 对外门面 pages.dev：sitemap/canonical/结构化数据全指向它。
Environment=FEDWATCH_SITE_URL=https://fedwatch-tracker.pages.dev
# 唯一发布渠道：publish_pages.sh 直发 Cloudflare Pages（2026-10-02 砍掉 nginx 镜像发布）。
ExecStart=/bin/zsh /opt/fedwatch-tracker/run_daily.sh
ExecStartPost=/opt/fedwatch-tracker/sync_data_git.sh
# 3 次抓取（间隔 10 分钟）+ 构建发布 + 3 次发布重试，留足余量
TimeoutStartSec=3h
